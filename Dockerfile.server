# VertexSlice headless slicer + HTTP API (Railway-ready). Not deployed by this repo.
# Build: docker build -f Dockerfile.server -t vertexslice-server:proof .
# Proof: docker run --rm vertexslice-server:proof /app/scripts/docker_headless_slice_proof.sh

FROM ubuntu:24.04 AS orca-builder

ENV DEBIAN_FRONTEND=noninteractive
ENV LC_ALL=C.UTF-8
ENV SKIP_RAM_CHECK=1
ENV ORCA_EXTRA_BUILD_ARGS=-DSLIC3R_GUI=OFF

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates sudo git \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . /src

RUN ./build_linux.sh -u \
    && ./build_linux.sh -dr \
    && CMAKE_BUILD_PARALLEL_LEVEL=4 ./build_linux.sh -sr

FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV ORCA_RESOURCES=/app/resources
ENV ORCA_SLICER_BIN=/app/bin/orca-slicer
ENV VERTEXSLICE_API_KEY=dev-change-me

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv \
    libstdc++6 libglib2.0-0 libgomp1 libcurl4 libssl3 libfuse2 \
    libgtk-3-0 libwebkit2gtk-4.1-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=orca-builder /src/build/src/Release/orca-slicer /app/bin/orca-slicer
COPY --from=orca-builder /src/resources /app/resources
COPY server /app/server
COPY validation /app/validation
COPY scripts/docker_headless_slice_proof.sh /app/scripts/docker_headless_slice_proof.sh

RUN chmod +x /app/bin/orca-slicer /app/scripts/docker_headless_slice_proof.sh \
    && python3 -m venv /app/venv \
    && /app/venv/bin/pip install --no-cache-dir -r /app/server/requirements.txt

ENV PATH="/app/venv/bin:${PATH}"
ENV PYTHONPATH="/app"

RUN /app/scripts/docker_headless_slice_proof.sh

EXPOSE 8080
CMD ["sh", "-c", "uvicorn server.app:app --host 0.0.0.0 --port ${PORT:-8080}"]
