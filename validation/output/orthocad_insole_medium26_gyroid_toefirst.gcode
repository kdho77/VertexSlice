M106 S0
M106 P1 S0
;TYPE:Custom
; filament end gcode 
;M106 P3 S0
M107
G92 E0 ; Set Extruder to zero
G1 E-1 ; Retract 1mm
G90
G91
G92 Z0 ; Set Belt to zero again
G28 Y ; Home Y
G28 X ; Home X
M104 S0 ; Extruder heater off
M140 S0 ; Heated bed heater off
G92 Z0

M82 ;absolute extrusion mode
M104 S0
;End of Gcode
PRINT_END
M73 P100 R0
; EXECUTABLE_BLOCK_END

